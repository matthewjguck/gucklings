# Supabase Configuration (NO SMS/OTP NEEDED!)
# Get these from your Supabase project settings → API
# Authentication is handled via phone number + family passcode from database
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Print Server Configuration
# URL of the print server (defaults to http://127.0.0.1:9100 if not set)
# VITE_PRINT_SERVER_URL=http://parents-printer.local:9100

# Print Backend Type
# Options: 'local' (direct USB), 'supabase' (cloud-based queue)
# Defaults to 'local'
# VITE_PRINT_BACKEND=local

# GIPHY API Configuration (optional)
# Get an API key from https://developers.giphy.com
# Only needed if you want sticker search functionality
# VITE_GIPHY_API_KEY=dc...your-giphy-key...

# Deployment Time (set automatically by build process)
# VITE_DEPLOYMENT_TIME=2024-01-01T00:00:00Z
